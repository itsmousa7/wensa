<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the HyperPay mSDK (oppwa.mobile) layout of the same name via
     Android resource merging. AsyncPaymentActivity adds its ThreeDSWebFragment
     into @id/content_view, so that id must stay. The header mirrors the Wensa
     dark toolbar used by the in-app challenge dialog in MainActivity; the close
     button is wired up from MainActivity via ActivityLifecycleCallbacks. -->
<!-- fitsSystemWindows keeps the header below the status bar (edge-to-edge);
     the root's dark background fills the status/navigation bar inset areas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wensa_challenge_header"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/wensa_challenge_header"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wensa_challenge_close"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:text="@string/wensa_challenge_cancel"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/wensa_challenge_title"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <View
            android:layout_width="48dp"
            android:layout_height="56dp" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/content_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
